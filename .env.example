# ---------------------------------------------------------------------------
# Range Compound bot — environment
#
# Copy to `.env` (which is gitignored) and fill in. Every REQUIRED variable is
# validated at process start (src/config/index.ts) — a missing one fails the
# boot loudly. Optional variables show their default.
# ---------------------------------------------------------------------------

# === Telegram (required) ===================================================
# Bot API token from @BotFather.
BOT_TOKEN=123456:ABC-DEF...

# Numeric id of the gated group/supergroup. For supergroups this is negative,
# e.g. -1001234567890. The bot must be an admin in this chat.
GROUP_CHAT_ID=-1001234567890

# Comma/space separated Telegram user ids allowed to run admin commands.
ADMIN_USER_IDS=11111111,22222222

# Optional secret used for the Telegram webhook path + header. If unset, a
# deterministic value is derived from the bot token.
# TELEGRAM_WEBHOOK_SECRET=

# === Stripe (required) =====================================================
# Secret API key (sk_live_... in production, sk_test_... locally).
STRIPE_SECRET_KEY=sk_test_...

# Signing secret for the /stripe/webhook endpoint (whsec_...). See README.
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Price ids for each plan.
PRICE_MONTHLY=price_...
PRICE_QUARTERLY=price_...
PRICE_ANNUAL=price_...

# === Database (required) ===================================================
# Postgres connection string. TLS is enabled automatically unless the host is
# localhost/127.0.0.1.
DATABASE_URL=postgres://user:password@host:5432/dbname

# === Server / public URL ===================================================
# Public HTTPS base URL of this service. Used to register the Telegram webhook
# and build Checkout redirects. On Railway this is derived automatically from
# RAILWAY_PUBLIC_DOMAIN, so you usually don't set it there.
# PUBLIC_URL=https://your-app.up.railway.app

# HTTP port (default 3000). Railway sets PORT for you.
# PORT=3000

# === Access / grace period =================================================
# Days a past_due member keeps group access before removal (default 3).
# GRACE_DAYS=3

# Hours a one-time group invite link stays valid (default 24).
# INVITE_EXPIRY_HOURS=24

# Cron expression (UTC) for the daily grace-period job (default "0 9 * * *").
# GRACE_CRON=0 9 * * *

# Cron expression (UTC) for lead follow-up delivery (default every 10 minutes).
# FOLLOWUP_CRON=*/10 * * * *

# === Economic calendar news module =========================================
# Entirely additive and OFF by default. If NEWS_ENABLED is false or
# NEWS_CHAT_ID is unset, every news job no-ops silently and nothing posts.

# Master switch (default false).
# NEWS_ENABLED=false

# Chat that receives calendar posts — normally the members' supergroup.
# Run /news_here inside the target topic to have the bot print both ids.
# NEWS_CHAT_ID=-1001234567890

# Forum topic within that chat. Leave unset (or set to 1) to post to General —
# both cases omit message_thread_id entirely, which is the reliable way to
# target a forum's General topic.
# NEWS_TOPIC_ID=42

# mock | rapidapi | trading_economics  (default mock — synthetic, no API calls).
# NEWS_PROVIDER=mock

# RapidAPI key for the Economic Calendar API. The account must be SUBSCRIBED to
# that API, not merely registered with RapidAPI.
# RAPIDAPI_KEY=your_rapidapi_key

# Trading Economics credential, "key:secret". Their historic guest:guest
# account has been DISCONTINUED and now returns HTTP 410 to every calendar
# request, so a paid key is required for real data.
# TE_API_KEY=your_key:your_secret

# Quiet hours as HH:MM in Asia/Makassar. Messages still post during these
# hours — they just arrive with notifications silenced. Both must be set.
# NEWS_QUIET_START=22:00
# NEWS_QUIET_END=07:00

# --- Cadence. Each of these spends provider quota; /news_status shows the
# rolling 30-day request count so consumption is visible before a plan limit.
# Minutes between calendar imports (default 360 = every 6 hours).
# NEWS_IMPORT_INTERVAL_MINUTES=360

# Seconds between result polls while an event sits inside its window
# (default 60). Only runs when an announced event is still awaiting its print.
# Note: the rapidapi provider raises the effective floor to 300s, because its
# upstream is only re-scraped every ~5 minutes — polling faster bills for
# identical data. Lowering this below 300 has no effect on that provider.
# NEWS_POLL_INTERVAL_SECONDS=60

# Minutes after release to keep polling for the actual (default 15). The
# upstream is scraped every ~5 minutes, so a print can legitimately land
# several minutes late; a short window silently misses it.
# NEWS_POLL_WINDOW_MINUTES=15

# HARD cap on provider requests per UTC calendar month (default 900). This
# blocks, it does not merely warn: at the cap every provider call stops and the
# admins get ONE DM. Resets automatically on the 1st. RapidAPI bills per
# request beyond the plan allowance with no platform-side ceiling, so an
# unattended retry loop is real financial exposure. Set to 0 to disable.
# NEWS_MONTHLY_REQUEST_CAP=900

# === Misc ==================================================================
# Max broadcast messages/second (default 25; Telegram global limit ~30).
# BROADCAST_PER_SECOND=25

# DM admins on every /start (new + returning users). Default true. Set false to
# silence entirely, e.g. during the legacy launch broadcast. Bursts above ~30
# starts/minute automatically collapse into per-minute summaries either way.
# NOTIFY_NEW_USERS=true

# DM admins on every money event (new member, renewal, cancellation, ended,
# plan change, payment failure). Default true. Independent of NOTIFY_NEW_USERS.
# NOTIFY_REVENUE=true

# development | production (default development).
# NODE_ENV=development

# Set to "debug" to emit debug logs (default off).
# LOG_LEVEL=debug
